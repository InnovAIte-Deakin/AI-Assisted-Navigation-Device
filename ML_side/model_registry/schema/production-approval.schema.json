{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://walkbuddy.local/schemas/production-approval.schema.json",
  "title": "WalkBuddy First Eight-Class Production Approval",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_type", "scope", "approval_outcome", "decision_date", "model", "reviewed_evidence_references", "accepted_limitations", "decision_summary"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "decision_type": {"const": "explicit_human_team_approval"},
    "scope": {"const": "first_structurally_valid_eight_class_production_promotion"},
    "approval_outcome": {"const": "approved"},
    "decision_date": {"type": "string", "format": "date"},
    "decision_summary": {"type": "string", "minLength": 1},
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["model_id", "model_version", "artifact_filename", "sha256", "ordered_taxonomy", "evaluation_evidence_reference"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1}, "model_version": {"type": "string", "minLength": 1},
        "artifact_filename": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "ordered_taxonomy": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "evaluation_evidence_reference": {"type": "string", "minLength": 1}
      }
    },
    "reviewed_evidence_references": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "accepted_limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
