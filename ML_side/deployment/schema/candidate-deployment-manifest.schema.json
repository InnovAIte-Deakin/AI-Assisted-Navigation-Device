{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://walkbuddy.local/schemas/candidate-deployment-manifest.schema.json",
  "title": "WalkBuddy Candidate Deployment Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "run_id", "expected_lifecycle", "expected_artifact_filename", "expected_sha256", "expected_size_bytes", "ordered_taxonomy", "registry_record_reference", "compute_policy"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "candidate_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "expected_lifecycle": {"enum": ["experimental", "candidate", "production", "rejected", "deprecated", "rolled_back"]},
    "expected_artifact_filename": {"type": "string", "minLength": 1},
    "expected_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "expected_size_bytes": {"type": "integer", "minimum": 1},
    "ordered_taxonomy": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "registry_record_reference": {"type": "string", "minLength": 1},
    "training_configuration_reference": {"type": ["string", "null"]},
    "evaluation_evidence_reference": {"type": ["string", "null"]},
    "minimum_backend_contract_version": {"type": ["string", "null"]},
    "compute_policy": {"enum": ["cpu_allowed", "cuda_preferred", "cuda_required"]},
    "notes": {"type": ["string", "null"]},
    "known_limitations": {"type": "array", "items": {"type": "string"}}
  }
}
